[Unit]
Description=Halcyon Protocol CTF box (noob-orientation)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/box
# Same start.sh every player runs manually on Docker -- generates a
# fresh CTF_SECRET on first boot if none exists yet, then brings the
# stack up. Idempotent: safe on every subsequent boot too.
ExecStart=/opt/box/start.sh
ExecStop=/usr/bin/docker compose -f /opt/box/docker-compose.yml down

[Install]
WantedBy=multi-user.target
